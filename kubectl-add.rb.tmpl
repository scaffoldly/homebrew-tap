# Template for kubectl-add's tap formula. update-formula.yml polls the latest
# release hourly and runs render.sh, which fills the @@...@@ placeholders from
# that release's archives and commits the result to Formula/kubectl-add.rb.
# One template per project; tush.rb.tmpl is the other.
#
# This is the tap formula: it installs the prebuilt release binary (the normal
# auto-updating build). The from-source, no-self-update homebrew-core formula
# is tracked separately in #23.
class KubectlAdd < Formula
  desc "Install anything into your cluster from whatever you point it at"
  homepage "https://github.com/scaffoldly/kubectl-add"
  version "@@VERSION@@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/scaffoldly/kubectl-add/releases/download/v@@VERSION@@/kubectl-add_darwin_arm64.zip"
      sha256 "@@SHA_DARWIN_ARM64@@"
    end
    on_intel do
      url "https://github.com/scaffoldly/kubectl-add/releases/download/v@@VERSION@@/kubectl-add_darwin_amd64.zip"
      sha256 "@@SHA_DARWIN_AMD64@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/scaffoldly/kubectl-add/releases/download/v@@VERSION@@/kubectl-add_linux_arm64.zip"
      sha256 "@@SHA_LINUX_ARM64@@"
    end
    on_intel do
      url "https://github.com/scaffoldly/kubectl-add/releases/download/v@@VERSION@@/kubectl-add_linux_amd64.zip"
      sha256 "@@SHA_LINUX_AMD64@@"
    end
  end

  def install
    bin.install "kubectl-add"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/kubectl-add --version")
  end
end
